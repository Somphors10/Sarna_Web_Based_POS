#--------------------------------------------------------------------
# WBPOS — Docker environment (.env)
# Copy to .env.docker before: docker compose -f docker-compose.wbpos.yml up -d --build
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# DATABASE (hostname/user/password/database are overridden by
# MYSQL_* env vars in docker-compose.wbpos.yml)
#--------------------------------------------------------------------

database.default.hostname = 'mysql'
database.default.database = 'wbpos'
database.default.username = 'wbpos'
database.default.password = 'wbpos123'
database.default.DBDriver = 'MySQLi'
database.default.DBPrefix = 'wbpos_'

database.development.hostname = 'mysql'
database.development.database = 'wbpos'
database.development.username = 'wbpos'
database.development.password = 'wbpos123'
database.development.DBDriver = 'MySQLi'
database.development.DBPrefix = 'wbpos_'

database.tests.hostname = 'mysql'
database.tests.database = 'wbpos'
database.tests.username = 'wbpos'
database.tests.password = 'wbpos123'
database.tests.DBDriver = 'MySQLi'
database.tests.DBPrefix = 'wbpos_'

#--------------------------------------------------------------------
# ENCRYPTION — generate your own for production
#--------------------------------------------------------------------

encryption.key = '18ade524011b729a178dbc041b160895d465ce4944c4fb71b9ce9c916a7788ae'

logger.threshold = 4
app.db_log_enabled = false

honeypot.hidden = true
honeypot.label = 'Fill This Field'
honeypot.name = 'honeypot'
honeypot.template = '<label>{label}</label><input type="text" name="{name}" value="">'
honeypot.container = '<div style="display:none">{template}</div>'

#--------------------------------------------------------------------
# TELEGRAM — alerts when a company registers (private chat OR group)
# Group: add @wbpos_system_bot to the group → send a message → getUpdates → use negative id
#--------------------------------------------------------------------

telegram.enabled = true
telegram.bot_token =
telegram.super_admin_chat_id =

#--------------------------------------------------------------------
# EMAIL — KHQR sent after Super Admin Activate
# Option A (Docker dev): MailHog — emails show at http://localhost:8025
# Option B (real Gmail): use your Gmail + App Password (Google Account → Security)
#--------------------------------------------------------------------

email.protocol = smtp
email.SMTPHost = mailhog
email.SMTPPort = 1025
email.SMTPCrypto =
email.SMTPUser =
email.SMTPPass =
email.fromEmail = wbpos@localhost
email.fromName = WBPOS

# Real Gmail example (replace with your values):
# email.SMTPHost = smtp.gmail.com
# email.SMTPPort = 587
# email.SMTPCrypto = tls
# email.SMTPUser = you@gmail.com
# email.SMTPPass = your-16-char-app-password
# email.fromEmail = you@gmail.com

#--------------------------------------------------------------------
# EMAIL — after Super Admin Activate, KHQR is sent to the owner's email
# For Gmail: create an App Password, then:
#   email.protocol = smtp
#   email.SMTPHost = smtp.gmail.com
#   email.SMTPUser = you@gmail.com
#   email.SMTPPass = your-app-password
#   email.SMTPPort = 587
#   email.SMTPCrypto = tls
#   email.fromEmail = you@gmail.com
#   email.fromName = WBPOS
#--------------------------------------------------------------------
