#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = 'localhost'
database.default.database = 'wbpos'         
database.default.username = 'root'          
database.default.password = ''              
database.default.DBDriver = 'MySQLi'
database.default.DBPrefix = 'wbpos_'

database.development.hostname = 'localhost'
database.development.database = 'wbpos'
database.development.username = 'root'
database.development.password = ''
database.development.DBDriver = 'MySQLi'
database.development.DBPrefix = 'wbpos_'

database.tests.hostname = 'localhost'
database.tests.database = 'wbpos'
database.tests.username = 'admin'
database.tests.password = 'pointofsale'
database.tests.DBDriver = 'MySQLi'
